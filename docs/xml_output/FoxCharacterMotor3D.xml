<?xml version="1.0" encoding="UTF-8" ?>
<class name="FoxCharacterMotor3D" inherits="FoxNode3D" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Moves itself based on an input direction and the strength of the input. Built in speed and jump_strength to control how fast the body moves and how high it can jump.
	</brief_description>

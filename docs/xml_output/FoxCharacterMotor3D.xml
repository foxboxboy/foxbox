	<members>
		<member name="body" type="CharacterBody3D" setter="" getter="">
			The body that will be acted upon. If unspecified, the node this is attached to will become the body.
		</member>
		<member name="speed" type="float" setter="" getter="" default="5.0">
			How fast the body will move.
		</member>
		<member name="jump_strength" type="float" setter="" getter="" default="9.5">
			How high the body will jump. Set to zero to disable jumping.
		</member>
		<member name="gravity_multiplier" type="float" setter="" getter="" default="2.5">
			How much the default gravity will apply. Makes the character feel more floaty (less than 1) or heavier (greater than 1).
		</member>
		<member name="input_direction" type="Vector2" setter="" getter="" default="Vector2(0, 0)">
			Direction the body will move when given input.
		</member>
		<member name="input_strength" type="float" setter="" getter="" default="1.0">
			How strong the input is, useful for joysticks.
		</member>
		<member name="active" type="bool" setter="@active_setter" getter="" default="true">
			Whether or not this motor will process.
		</member>
	</members>

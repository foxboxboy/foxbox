		<method name="enable">
			<return type="void" />
			<description>
				Enables the motor to work.
			</description>
		</method>
		<method name="disable">
			<return type="void" />
			<description>
				Enables the motor to work.
			</description>
		</method>
		<method name="jump">
			<return type="void" />
			<param index="0" name="multiplier" type="float" default="1.0" />
			<description>
				Makes the body jump based on jump_strength multiplied by the multiplier passed in.
			</description>

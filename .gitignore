# Godot 4+ specific ignores
.godot/
/android/

# Export output. Built demo binaries, regenerate from export_presets.cfg.
exports/

# Editor and tooling artifacts
.aider*
*.tmp

# Python bytecode from the docs tooling
__pycache__/
*.py[cod]

# Generated API docs. See docs/README.txt to rebuild.
docs/xml_output/
docs/xml_engine/
docs/rst_output/
docs/web/_build/

# docs/web/class_*.rst and module_*.rst are deliberately NOT ignored. Read the Docs has no
# Godot to run, so it can only render pages that are committed. CI regenerates and pushes them.

# Vendored Godot engine files the doc tooling does not use
docs/tools/misc/*
!docs/tools/misc/utility/

# Word and LibreOffice lock files, created while a document in planning/ is open
~$*
.~lock.*

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
